[Desktop Entry]
Version=1.0
Type=Application
Name=EnvGuard Secrets Vault
GenericName=Secret Scanner & Encrypted Vault
Comment=Secret Scanner, Credential Sanitizer, AES-256-CTR-HMAC-SHA256 Vault & Shamir Quorum Studio
Exec=/usr/local/bin/envguard desktop
Icon=envguard-secrets-vault
Terminal=false
Categories=Security;Development;System;Utility;
StartupNotify=true
Actions=CLI;Web;

[Desktop Action CLI]
Name=Open EnvGuard CLI
Exec=x-terminal-emulator -e "/usr/local/bin/envguard --help"

[Desktop Action Web]
Name=Open Web UI (Port 8088)
Exec=/usr/local/bin/envguard web
