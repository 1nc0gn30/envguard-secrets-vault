# ==============================================================================
# Next.js Environment Template (.env.example)
# Sanitized with EnvGuard Secrets Vault — Safe for Version Control
# ==============================================================================

# Core App Settings
PORT=3000
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
APP_URL=http://localhost:3000

# Database Persistence
DATABASE_URL=postgresql://user:password@localhost:5432/acme_dev?sslmode=prefer
DIRECT_URL=postgresql://user:password@localhost:5432/acme_dev

# Authentication & Session Keys (Generate with `openssl rand -hex 32`)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars-long
JWT_SIGNING_KEY=your-jwt-signing-key-32-bytes-hex

# Stripe Payment Keys (NOTE: Keep secret keys off client-side NEXT_PUBLIC_ prefixes!)
STRIPE_SECRET_KEY=your-stripe-secret-key-here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# AI Provider API Keys
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-claude-api-key-here

# Cloud Infrastructure (AWS S3 Asset Uploads)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
S3_BUCKET_NAME=acme-dev-assets

# Third-Party Integrations
GITHUB_PERSONAL_ACCESS_TOKEN=your-github-token-here
RESEND_API_KEY=your-resend-api-key-here
SLACK_BOT_TOKEN=your-slack-bot-token-here
REDIS_URL=redis://localhost:6379
